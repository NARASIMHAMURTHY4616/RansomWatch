# RansomWatch Configuration
# Set your Gemini API key below to enable post-detection AI analysis
GEMINI_API_KEY="add your api key"
# Application Server
HOST=127.0.0.1
PORT=8000

# Monitoring Settings
MONITOR_WINDOW_SECONDS=5.0

# Detection & Risk Thresholds
RISK_THRESHOLD_LOW=30
RISK_THRESHOLD_MEDIUM=60
RISK_THRESHOLD_HIGH=80
